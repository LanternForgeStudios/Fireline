rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each player can only read/write their own profile and mission
    // history — never another player's. Full anti-cheat (re-deriving
    // rewards server-side) would need Cloud Functions; this is the
    // client-writes-directly model appropriate for an arcade MVP.
    match /players/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /missionResults/{resultId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
